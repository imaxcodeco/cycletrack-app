<?xml version="1.0" encoding="utf-8"?>
<!--
    Background da splash screen do CycleTrack.
    Gradiente da marca (rosa -> roxo) com icone centralizado.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/primary_500"
                android:centerColor="@color/primary_600"
                android:endColor="@color/primary_700"
                android:type="linear" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/logo_cycletrack"
        android:gravity="center"
        android:width="140dp"
        android:height="140dp" />

</layer-list>
