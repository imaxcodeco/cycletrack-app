<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de extração de dados (Android 12+ / API 31+).
    LGPD: dados sensíveis de saúde não devem ir para backup na nuvem sem consentimento.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="database" path="cycletrack_analytics.db" />
        <exclude domain="file" path="export/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="file" path="export/" />
    </device-transfer>
</data-extraction-rules>
